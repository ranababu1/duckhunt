; Engine configuration file.
; Edit through the Godot editor where possible.
config_version=5

[application]
config/name="Duck Hunt Arcade"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.0", "GL Compatibility")

[display]

[display/window]
size/viewport_width=960
size/viewport_height=540
size/window_width_override=960
size/window_height_override=540
stretch/mode="canvas_items"
stretch/aspect="keep"
handheld/orientation=1

[rendering]
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[input]
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
