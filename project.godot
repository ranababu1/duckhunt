; Engine configuration file.
; Edit through the Godot editor where possible.
config_version=5

[application]
config/name="Open Range"
config/version="0.1.0"
config/icon="res://assets/ui/open_range_app_icon.svg"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.0", "GL Compatibility")
boot_splash/image="res://assets/backgrounds/open_range_day.png"
boot_splash/bg_color=Color(0.1333, 0.7882, 0.7922, 1)
boot_splash/show_image=true
boot_splash/stretch_mode=1
boot_splash/use_filter=false

[display]

[display/window]
size/viewport_width=960
size/viewport_height=540
size/window_width_override=960
size/window_height_override=540
stretch/mode="canvas_items"
stretch/aspect="keep"
handheld/orientation=0

[rendering]
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[input]
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
